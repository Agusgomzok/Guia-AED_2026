/*Se posee un arreglo de 200 libros con el siguiente formato:

NRO_LIBRO	TITULO	AUTOR	CANT_HOJAS
ordenado por AUTOR y se presentan las siguientes premisas:

Se necesita saber que libros se poseen de “Nicklaus Wirth”.
Se necesita saber en qué posición se encuentra “Algoritmos + Estructuras de Datos=Programa”.
Se necesita saber cual es el libro de “Nicklaus Wirth” de mayor volumen.*/
accion 3.9 es
    ambiente
        libro =  registro
            nro_libro: entero
            titulo: AN (49)
            autor: AN (29)
            cant_hojas: entero
        finregistro

        libros: arreglo de [1..200] de libro //el registro libro se encuentra ordenado por autor
        i: 1..100

        max_hojas: entero


    proceso
        para i:= 1 a 200 hacer
            si libros[i].autor = "Nicklaus Wirth" entonces
                escribir("titulo:",libros[i].titulo)
            finsi
finaccion 

ACCION 3.9 ES
    Ambiente
        libro = REGISTRO
            nro_libro: Entero
            titulo: AN(49)
            autor: AN(29)
            cant_hojas: Entero
        FIN_REGISTRO

        libros: Arreglo [1..200] de libro // El arreglo se encuentra ordenado por autor
        i: 1..200

        // Variables para búsqueda de mayor volumen de Nicklaus Wirth
        max_hojas: Entero
        pos_max_vol: Entero
        tiene_wirth: Booleano

        // Variables para localización por título
        pos_libro_buscado: Entero

    Proceso
        // Inicialización de variables
        max_hojas := -1
        pos_max_vol := 0
        tiene_wirth := Falso
        pos_libro_buscado := 0

        ESCRIBIR("--- LIBROS DE NICKLAUS WIRTH ---")

        PARA i := 1 HASTA 100 HACER
            // Requerimiento 1 y 3: Libros de Nicklaus Wirth y búsqueda de mayor volumen
            SI libros[i].autor = "Nicklaus Wirth" ENTONCES
                ESCRIBIR("Título: ", libros[i].titulo)
                tiene_wirth := Verdadero

                SI libros[i].cant_hojas > max_hojas ENTONCES
                    max_hojas := libros[i].cant_hojas
                    pos_max_vol := i
                FIN_SI
            FIN_SI

            // Requerimiento 2: Localizar posición del libro por título
            SI libros[i].titulo = "Algoritmos + Estructuras de Datos=Programa" ENTONCES
                pos_libro_buscado := i
            FIN_SI
        FIN_PARA

        // Informar resultado de la búsqueda por título
        SI pos_libro_buscado <> 0 ENTONCES
            ESCRIBIR("El libro 'Algoritmos + Estructuras de Datos=Programa' se encuentra en la posición: ", pos_libro_buscado)
        SINO
            ESCRIBIR("El libro 'Algoritmos + Estructuras de Datos=Programa' no fue encontrado en el arreglo.")
        FIN_SI

        // Informar libro de mayor volumen de Nicklaus Wirth
        SI tiene_wirth ENTONCES
            ESCRIBIR("El libro de mayor volumen de Nicklaus Wirth es: ", libros[pos_max_vol].titulo, " con ", max_hojas, " hojas.")
        SINO
            ESCRIBIR("No se registraron libros del autor Nicklaus Wirth.")
        FIN_SI
FIN_ACCION